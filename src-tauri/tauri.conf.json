{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude History",
  "version": "0.1.0",
  "identifier": "local.pulad.claude-history",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Claude History",
        "width": 1600,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#191918",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
